# Copy this file to server/.env and set a strong secret before running in production
# Do NOT commit server/.env with real secrets to git

# JWT secret used to sign tokens
JWT_SECRET=replace_with_a_strong_random_value

# Optional: path to SQLite DB file (absolute or relative to repo root)
# Defaults to ./server/data.sqlite
DB_FILE=./server/data.sqlite

# Server port
PORT=4000
